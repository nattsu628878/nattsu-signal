---
import BaseLayout from '../../layouts/BaseLayout.astro';

const base = import.meta.env.BASE_URL;
const gameUrl = `${base}museum/game/`;
---

<BaseLayout title="Museum" active="museum">
  <div class="container museum-page">
    <div class="museum-heading">
      <h1 class="section-title">Museum</h1>
      <a href={gameUrl} target="_blank" rel="noopener noreferrer">open in new tab ↗</a>
    </div>
    <div class="museum-frame">
      <iframe
        src={gameUrl}
        title="Nattsu Photo Museum — first-person gallery"
        allow="fullscreen; gamepad"
        allowfullscreen
        loading="lazy"
      ></iframe>
    </div>
  </div>
</BaseLayout>

<style>
  .museum-page {
    max-width: 1440px;
  }

  .museum-heading {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 1rem;
  }

  .museum-heading .section-title {
    flex: 1;
  }

  .museum-heading a {
    color: var(--accent);
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-decoration: none;
    white-space: nowrap;
  }

  .museum-heading a:hover {
    text-decoration: underline;
  }

  .museum-frame {
    aspect-ratio: 16 / 10;
    min-height: 460px;
    border: 1px solid var(--border-color);
    background: #202120;
  }

  iframe {
    display: block;
    width: 100%;
    height: 100%;
    border: 0;
  }

  @media (max-width: 640px) {
    .museum-frame {
      min-height: 380px;
    }

    .museum-heading {
      align-items: center;
    }
  }
</style>
