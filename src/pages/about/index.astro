---
import BaseLayout from '../../layouts/BaseLayout.astro';
import PublishingActivity from '../../components/PublishingActivity.astro';

const links = [
  { label: 'GitHub', href: 'https://github.com/nattsu628878' },
  { label: 'X', href: 'https://x.com/nattsu_628878' },
  { label: 'Bluesky', href: 'https://bsky.app/profile/nattsu628878.bsky.social' },
  { label: 'note', href: 'https://note.com/nattsu_628878' },
  { label: 'Qiita', href: 'https://qiita.com/nattsu' },
  { label: 'YouTube', href: 'https://www.youtube.com/@nattsu6__8878' },
];
---

<BaseLayout title="About" active="about">
  <div class="container">
    <h1 class="section-title">About</h1>

    <section style="margin-bottom: 2rem;">
      <h2 class="subsection-title">Links</h2>
      <ul style="list-style: none; display: flex; gap: 1rem; flex-wrap: wrap;">
        {links.map((l) => (
          <li>
            <a href={l.href} target="_blank" rel="noopener noreferrer" style="color: var(--accent); font-weight: 600; text-decoration: none;">
              {l.label} ↗
            </a>
          </li>
        ))}
      </ul>
    </section>

    <section>
      <h2 class="subsection-title">Activity</h2>
      <PublishingActivity />
    </section>
  </div>
</BaseLayout>
