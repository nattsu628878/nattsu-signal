---
import BaseLayout from '../layouts/BaseLayout.astro';
import OpusCard from '../components/OpusCard.astro';
import { getCollection } from 'astro:content';

const featured = (await getCollection('opus', ({ data }) => data.featured)).sort(
  (a, b) => b.data.date.valueOf() - a.data.date.valueOf()
);
const base = import.meta.env.BASE_URL;
---

<BaseLayout title="Home" active="home">
  <div class="container hero">
    <h1>nattsu</h1>
    <p>構造を発見し、形にする人。音楽・DSP・Web・3Dを横断して作る個人研究者。</p>
  </div>
  <div class="container">
    <div class="section-header-row">
      <h2 class="section-title">Featured</h2>
      <a class="see-all" href={`${base}opus/`}>Opusをすべて見る →</a>
    </div>
    <div class="opus-grid">
      {featured.map((item) => <OpusCard {...item.data} />)}
    </div>
  </div>
</BaseLayout>
