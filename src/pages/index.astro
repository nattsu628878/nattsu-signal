---
import { getCollection } from 'astro:content';
import BaseLayout from '../layouts/BaseLayout.astro';
import OpusCard from '../components/OpusCard.astro';
import VideoGallery from '../components/VideoGallery.astro';
import { getVideos } from '../lib/videos';

const opusUrl = `${import.meta.env.BASE_URL}opus/`;
const [featured, videos] = await Promise.all([
  getCollection('opus', ({ data }) => data.featured),
  getVideos(),
]);
featured.sort((a, b) => b.data.date.valueOf() - a.data.date.valueOf());
---

<BaseLayout title="Home" active="home">
  <div class="container hero">
    <h1>natʇsu</h1>
    <p lang="ja">音楽、ソフトウェア、その他、</p>
  </div>
  {featured.length > 0 && (
    <section class="container featured" aria-labelledby="featured-heading">
      <div class="section-header-row">
        <h2 class="section-title" id="featured-heading">Opus</h2>
        <a class="see-all" href={opusUrl} aria-label="View all Opus entries">
          View all <span class="arrow" aria-hidden="true">→</span>
        </a>
      </div>
      <div class="opus-grid">
        {featured.map((item) => (
          <OpusCard
            id={item.id}
            {...item.data}
            link={`${opusUrl}#${item.id}`}
            linkLabel="View project"
            external={false}
          />
        ))}
      </div>
    </section>
  )}
  <section class="container" aria-labelledby="videos-heading">
    <div class="section-header-row">
      <h2 class="section-title" id="videos-heading">Videos</h2>
      <a
        class="see-all"
        href="https://www.youtube.com/@nattsu6__8878"
        target="_blank"
        rel="noopener noreferrer">YouTube <span class="arrow">↗</span></a
      >
    </div>
    <VideoGallery videos={videos} />
  </section>
</BaseLayout>

<style>
  .featured {
    margin-bottom: var(--space-8);
  }
</style>
