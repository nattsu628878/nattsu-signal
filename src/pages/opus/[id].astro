---
import { getCollection, render, type CollectionEntry } from 'astro:content';
import OpusLayout from '../../layouts/OpusLayout.astro';

export async function getStaticPaths() {
  const entries = await getCollection('opus', ({ data }) => !data.customPage);
  return entries.map((entry) => ({ params: { id: entry.id }, props: { entry } }));
}

interface Props {
  entry: CollectionEntry<'opus'>;
}

const { entry } = Astro.props;
const { title, description, image, link, linkLabel } = entry.data;
const { Content } = await render(entry);
const imageSrc = `${import.meta.env.BASE_URL}${image.replace(/^\//, '')}`;
---

<OpusLayout title={title}>
  <article class="container">
    <header>
      <h1 class="section-title">{title}</h1>
      <p class="summary" lang="ja">{description}</p>
      {link && <a class="external" href={link}>{linkLabel ?? 'Open'} <span aria-hidden="true">↗</span></a>}
    </header>
    <img src={imageSrc} alt={`${title}の画面`} lang="ja" width="1280" height="800" />
    <div class="content" lang="ja"><Content /></div>
  </article>
</OpusLayout>

<style>
  article {
    max-width: 54rem;
    padding-bottom: var(--space-8);
  }

  .summary, .content {
    max-width: var(--measure);
    line-height: 1.8;
    overflow-wrap: anywhere;
  }

  .external {
    display: inline-block;
    margin-top: var(--space-3);
  }

  article img {
    display: block;
    width: 100%;
    height: auto;
    margin-block: var(--space-6);
    border: 1px solid var(--border-color);
  }

  .content :global(h2) {
    margin-block: var(--space-6) var(--space-2);
    font-size: 1.125rem;
  }

  .content :global(p + p) {
    margin-top: var(--space-3);
  }

  .content :global(ul), .content :global(ol) {
    padding-inline-start: var(--space-6);
  }
</style>
