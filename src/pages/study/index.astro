---
import BaseLayout from '../../layouts/BaseLayout.astro';

// 自分の学習用に作ったサイトをまとめた統合リンクページ。
// ナビゲーションには載せず(このファイルへの導線を張らない)、<meta robots noindex>で
// 検索エンジンからも除外する。nattsu-signalがpublicリポジトリである以上、
// ソースコード自体は誰でも読めるが、サイト上で人目にはつかない状態にする。

interface LinkItem {
  name: string;
  desc: string;
  href: string;
  note?: string;
}

interface Group {
  label: string;
  items: LinkItem[];
}

const groups: Group[] = [
  {
    label: 'Music & Audio',
    items: [
      {
        name: 'modulation-atlas',
        desc: 'A field guide to modulation schemes (AM/FM/PSK/QAM and more) with measured FFTs alongside theory',
        href: 'https://nattsu628878.github.io/modulation-atlas/',
      },
      {
        name: 'audio-dsp-workbook',
        desc: 'An intro to audio DSP in 10 chapters',
        href: 'https://nattsu628878.github.io/audio-dsp-workbook/',
      },
      {
        name: 'logic-fx-guide',
        desc: "A guide to Logic Pro's built-in effects",
        href: 'https://nattsu628878.github.io/logic-fx-guide/',
      },
      {
        name: 'music-genre-map',
        desc: 'A guide tracing the history and lineage of music genres via network graphs and timelines',
        href: 'https://nattsu628878.github.io/music-genre-map/',
      },
    ],
  },
  {
    label: 'Video & Color',
    items: [
      {
        name: 'davinci-resolve-guide',
        desc: 'A learning guide for DaVinci Resolve (video editing)',
        href: 'https://nattsu628878.github.io/davinci-resolve-guide/',
      },
      {
        name: 'lut-visualizer',
        desc: 'A visualizer for 3D LUTs (color transforms), with a LUT basics guide',
        href: 'https://nattsu628878.github.io/lut-visualizer/',
      },
    ],
  },
  {
    label: 'Tech & Creation',
    items: [
      {
        name: 'technology-universe',
        desc: 'An exploration map of technology and creation, branching out from the computer',
        href: 'https://nattsu628878.github.io/technology-universe/',
      },
    ],
  },
  {
    label: 'Programming',
    items: [
      {
        name: 'rust-syntax-tour',
        desc: 'A learning repo touring Rust syntax',
        href: 'https://github.com/nattsu628878/rust-syntax-tour',
        note: 'private repo, no Pages',
      },
    ],
  },
];
---

<BaseLayout title="Study" active="study" noindex>
  <div class="container">
    <h1 class="section-title">Study</h1>
    <p class="study-lede">A list of sites and repos I built for my own learning. Not linked in the site nav.</p>

    {groups.map((group) => (
      <div class="study-group">
        <h2 class="subsection-title">{group.label}</h2>
        <ul class="study-links">
          {group.items.map((item) => (
            <li>
              <a href={item.href} target="_blank" rel="noopener noreferrer">
                <span class="study-name">{item.name}</span>
                <span class="study-desc">{item.desc}</span>
                {item.note && <span class="study-note">{item.note}</span>}
              </a>
            </li>
          ))}
        </ul>
      </div>
    ))}
  </div>
</BaseLayout>

<style>
  .study-lede {
    color: var(--text-secondary);
    margin-bottom: 2rem;
  }

  .study-group {
    margin-bottom: 2rem;
  }

  .study-links {
    list-style: none;
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .study-links a {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.6rem;
    text-decoration: none;
    color: inherit;
    padding: 0.7rem 0.9rem;
    border-radius: 8px;
    border: 1px solid var(--border-light);
    background: var(--bg-panel);
    transition: border-color 0.15s, background 0.15s;
  }

  .study-links a:hover {
    border-color: var(--accent);
    background: var(--accent-bg);
  }

  .study-name {
    font-family: var(--font-mono);
    font-weight: 700;
    color: var(--accent);
    font-size: 0.9rem;
  }

  .study-desc {
    color: var(--text-secondary);
    font-size: 0.85rem;
    flex: 1;
  }

  .study-note {
    font-family: var(--font-mono);
    font-size: 0.68rem;
    color: var(--text-muted);
    border: 1px solid var(--border-color);
    border-radius: 4px;
    padding: 0.1rem 0.4rem;
    white-space: nowrap;
  }
</style>
