---
import BaseLayout from '../../layouts/BaseLayout.astro';
import BlueskyTimeline from '../../components/BlueskyTimeline.astro';

const HANDLE = 'nattsu628878.bsky.social';
---

<BaseLayout title="Timeline" active="timeline">
  <div class="container">
    <div class="section-header-row">
      <h1 class="section-title">Timeline</h1>
      <a
        class="see-all"
        href={`https://bsky.app/profile/${HANDLE}`}
        target="_blank"
        rel="noopener noreferrer">Bluesky ↗</a
      >
    </div>
    <BlueskyTimeline handle={HANDLE} />
  </div>
</BaseLayout>
