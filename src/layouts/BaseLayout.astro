---
import '../styles/global.css';

interface Props {
  title: string;
  active: 'home' | 'about' | 'opus' | 'article' | 'timeline';
}

const { title, active } = Astro.props;

const nav: { href: string; label: string; key: Props['active'] }[] = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/about/', label: 'About', key: 'about' },
  { href: '/opus/', label: 'Opus', key: 'opus' },
  { href: '/article/', label: 'Article', key: 'article' },
  { href: '/timeline/', label: 'Timeline', key: 'timeline' },
];
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>nattsu</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container">
        <a class="site-title" href="/">nat<span class="mirror-t">t</span>su</a>
        <nav>
          <ul class="site-nav">
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={item.key === active ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main aria-label={title}>
      <slot />
    </main>
  </body>
</html>
