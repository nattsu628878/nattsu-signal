---
import '../styles/global.css';

interface Props {
  title: string;
  active: 'home' | 'about' | 'opus' | 'article' | 'timeline';
}

const { title, active } = Astro.props;

const nav: { href: string; label: string; key: Props['active'] }[] = [
  { href: '/', label: 'Home', key: 'home' },
  { href: '/about/', label: 'About', key: 'about' },
  { href: '/opus/', label: 'Opus', key: 'opus' },
  { href: '/article/', label: 'Article', key: 'article' },
  { href: '/timeline/', label: 'Timeline', key: 'timeline' },
];
---

<html lang="ja">
  <head>
    <meta charset="utf-8" />
    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link
      href="https://fonts.googleapis.com/css2?family=Space+Mono:wght@400;700&family=M+PLUS+1:wght@400;500;700&display=swap"
      rel="stylesheet"
    />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" href="/favicon.ico" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="generator" content={Astro.generator} />
    <title>natʇsu</title>
  </head>
  <body>
    <header class="site-header">
      <div class="container site-header-row">
        <a class="site-title" href="/">natʇsu</a>
        <button
          class="nav-toggle"
          id="nav-toggle"
          type="button"
          aria-label="メニューを開く"
          aria-expanded="false"
          aria-controls="site-nav"
        >
          <span class="bar"></span>
          <span class="bar"></span>
          <span class="bar"></span>
        </button>
        <nav class="site-nav-collapse" id="site-nav">
          <ul class="site-nav">
            {nav.map((item) => (
              <li>
                <a href={item.href} aria-current={item.key === active ? 'page' : undefined}>
                  {item.label}
                </a>
              </li>
            ))}
          </ul>
        </nav>
      </div>
    </header>
    <main aria-label={title}>
      <slot />
    </main>
    <script is:inline>
      const toggle = document.getElementById('nav-toggle');
      const nav = document.getElementById('site-nav');
      toggle?.addEventListener('click', () => {
        const isOpen = nav.classList.toggle('open');
        toggle.classList.toggle('open', isOpen);
        toggle.setAttribute('aria-expanded', String(isOpen));
        toggle.setAttribute('aria-label', isOpen ? 'メニューを閉じる' : 'メニューを開く');
      });
    </script>
  </body>
</html>
