---
interface Props {
  title: string;
  category: 'dev' | 'music' | 'photo';
  description: string;
  link?: string;
  image: string;
}

const { title, category, description, link, image } = Astro.props;
const Tag = link ? 'a' : 'div';
const linkProps = link ? { href: link, target: '_blank', rel: 'noopener noreferrer' } : {};
---

<Tag class="opus-card" {...linkProps}>
  <div class="thumb">
    <img src={image} alt={`${title} のスクリーンショット`} loading="lazy" />
  </div>
  <div class="body">
    <span class="category">{category}</span>
    <h3>{title}</h3>
    <p>{description}</p>
    {link && <span class="link-out">open ↗</span>}
  </div>
</Tag>
