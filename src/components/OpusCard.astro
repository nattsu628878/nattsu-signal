---
interface Props {
  id: string;
  title: string;
  category: 'dev' | 'music' | 'photo';
  description: string;
  link?: string;
  linkLabel?: string;
  external?: boolean;
  image: string;
  org?: 'nattsu' | 'kzgrm';
}

const {
  id, title, category, description, link, linkLabel = 'Open', external = true, image, org = 'nattsu',
} = Astro.props;
const Tag = link ? 'a' : 'div';
const externalProps = external ? { target: '_blank', rel: 'noopener noreferrer' } : {};
// contentの image は "/opus/xxx.png"（または .webp）というルート絶対パスで保存されているため、
// GitHub Pagesのbase(/nattsu-signal)を前置してから使う。
const imageSrc = `${import.meta.env.BASE_URL}${image.replace(/^\//, '')}`;
---

<Tag
  id={id}
  class:list={['opus-card', { 'opus-card--kzgrm': org === 'kzgrm' }]}
  {...(link ? { href: link, ...externalProps } : {})}
>
  <div class="thumb">
    <img src={imageSrc} alt={`${title} screenshot`} loading="lazy" />
  </div>
  <div class="body">
    <div class="tags">
      <span class="category">{category}</span>
      {org === 'kzgrm' && <span class="org-badge">kzgrm</span>}
    </div>
    <h3>{title}</h3>
    <p lang="ja">{description}</p>
    {link && (
      <span class="link-out">
        {linkLabel} <span class="arrow" aria-hidden="true">{external ? '↗' : '→'}</span>
      </span>
    )}
  </div>
</Tag>

<style>
  .opus-card {
    scroll-margin-top: 5rem;
  }
</style>
