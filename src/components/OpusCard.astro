---
interface Props {
  title: string;
  category: 'dev' | 'music' | 'photo';
  description: string;
  link?: string;
  image: string;
  org?: 'nattsu' | 'kzgrm';
}

const { title, category, description, link, image, org = 'nattsu' } = Astro.props;
const Tag = link ? 'a' : 'div';
const linkProps = link ? { href: link, target: '_blank', rel: 'noopener noreferrer' } : {};
// contentの image は "/opus/xxx.png" というルート絶対パスで保存されているため、
// GitHub Pagesのbase(/nattsu-signal)を前置してから使う。
const imageSrc = `${import.meta.env.BASE_URL}${image.replace(/^\//, '')}`;
---

<Tag class:list={['opus-card', { 'opus-card--kzgrm': org === 'kzgrm' }]} {...linkProps}>
  <div class="thumb">
    <img src={imageSrc} alt={`${title} のスクリーンショット`} loading="lazy" />
  </div>
  <div class="body">
    <div class="tags">
      <span class="category">{category}</span>
      {org === 'kzgrm' && <span class="org-badge">kzgrm</span>}
    </div>
    <h3>{title}</h3>
    <p>{description}</p>
    {link && <span class="link-out">open ↗</span>}
  </div>
</Tag>
