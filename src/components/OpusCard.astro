---
interface Props {
  id: string;
  title: string;
  category: 'dev' | 'music' | 'photo';
  description: string;
  image: string;
  org?: 'nattsu' | 'kzgrm';
}

const { id, title, category, description, image, org = 'nattsu' } = Astro.props;
// contentの image は "/opus/xxx.png"（または .webp）というルート絶対パスで保存されているため、
// GitHub Pagesのbase(/nattsu-signal)を前置してから使う。
const imageSrc = `${import.meta.env.BASE_URL}${image.replace(/^\//, '')}`;
---

<a
  id={id}
  class:list={['opus-card', { 'opus-card--kzgrm': org === 'kzgrm' }]}
  href={`${import.meta.env.BASE_URL}opus/${id}/`}
>
  <div class="thumb">
    <img src={imageSrc} alt="" width="1280" height="800" loading="lazy" />
  </div>
  <div class="body">
    <div class="tags">
      <span class="category">{category}</span>
      {org === 'kzgrm' && <span class="org-badge">kzgrm</span>}
    </div>
    <h3>{title}</h3>
    <p lang="ja">{description}</p>
    <span class="link-out">View details <span class="arrow" aria-hidden="true">→</span></span>
  </div>
</a>

<style>
  .opus-card {
    scroll-margin-top: 5rem;
  }
</style>
