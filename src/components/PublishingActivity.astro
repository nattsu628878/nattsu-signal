---
import { getArticles } from '../lib/articles';
import { getVideos } from '../lib/videos';

const [articles, videos] = await Promise.all([getArticles(), getVideos()]);
const events = [
  ...videos.map(({ date, title, url }) => ({ date, title, url, source: 'YouTube' })),
  ...articles.map(({ date, title, url, source }) => ({ date, title, url, source })),
];
const sources = [
  { name: 'YouTube', color: '#e34848' },
  { name: 'note', color: '#e8be28' },
  { name: 'Qiita', color: '#8bcf39' },
  { name: 'Bluesky', color: '#428de0' },
];
---

<div class="publishing-activity" data-events={JSON.stringify(events)}>
  <div class="contributions" tabindex="0" aria-label="GitHub活動と投稿・更新カレンダー（横スクロール可）">
    <p class="status">読み込み中…</p>
  </div>
  <div class="day-zoom" hidden aria-label="この日の投稿"></div>
  <div class="day-detail" hidden aria-label="投稿リンク"></div>
  <ul class="legend" aria-label="投稿の種類">
    <li><span class="github-key" aria-hidden="true"></span>GitHub</li>
    {sources.map(({ name, color }) => <li><span style={`background: ${color}`} aria-hidden="true"></span>{name}</li>)}
  </ul>
  <p class="activity-status" aria-live="polite">Blueskyを読み込み中…</p>
  <p class="github-status" aria-live="polite">GitHubを読み込み中…</p>
  <noscript>投稿カレンダーを表示するにはJavaScriptを有効にしてください。</noscript>
</div>

<script>
  type Activity = { date: string; source: string; title: string; url: string };
  const sources = ['YouTube', 'note', 'Qiita', 'Bluesky'];
  const colors = ['#e34848', '#e8be28', '#8bcf39', '#428de0'];
  const DAY = 86400000;

  async function renderActivity(root: HTMLElement) {
    const events: Activity[] = JSON.parse(root.dataset.events ?? '[]');
    const grid = root.querySelector<HTMLElement>('.contributions')!;
    const status = root.querySelector<HTMLElement>('.activity-status')!;
    const githubStatus = root.querySelector<HTMLElement>('.github-status')!;
    const detail = root.querySelector<HTMLElement>('.day-detail')!;
    const zoom = root.querySelector<HTMLElement>('.day-zoom')!;
    let activeCell: HTMLButtonElement | undefined;
    let resetLens = () => {};
    let suppressFocus = false;
    let closeTimer: ReturnType<typeof setTimeout> | undefined;
    const cancelClose = () => clearTimeout(closeTimer);
    const close = () => {
      cancelClose();
      detail.hidden = true;
      zoom.hidden = true;
      resetLens();
      activeCell?.setAttribute('aria-expanded', 'false');
      activeCell = undefined;
    };
    const scheduleClose = () => {
      cancelClose();
      closeTimer = setTimeout(() => {
        if (!grid.matches(':hover') && !zoom.matches(':hover') && !zoom.contains(document.activeElement) && !detail.matches(':hover') && !detail.contains(document.activeElement) && document.activeElement !== activeCell) close();
      }, 220);
    };
    detail.addEventListener('pointerenter', cancelClose);
    detail.addEventListener('pointerleave', scheduleClose);
    zoom.addEventListener('pointerenter', cancelClose);
    zoom.addEventListener('pointerleave', scheduleClose);
    grid.addEventListener('pointerenter', cancelClose);
    grid.addEventListener('pointerleave', scheduleClose);
    root.addEventListener('focusout', () => setTimeout(() => {
      if (!root.contains(document.activeElement)) close();
    }, 0));
    root.addEventListener('keydown', (event) => {
      if (event.key === 'Escape') {
        const cell = activeCell;
        close();
        suppressFocus = true;
        cell?.focus();
        suppressFocus = false;
        close();
      }
    });
    document.addEventListener('pointerdown', (event) => {
      if (!root.contains(event.target as Node)) close();
    });
    grid.addEventListener('scroll', close);
    window.addEventListener('resize', close);
    const github = new Map<string, { count: number; level: number }>();
    const today = new Date().toISOString().slice(0, 10);
    const end = Date.parse(today);
    const startDate = new Date(end);
    startDate.setUTCFullYear(startDate.getUTCFullYear() - 1);
    // GitHubの草と同じく、1年前を含む週の日曜日から揃える。
    startDate.setUTCDate(startDate.getUTCDate() - startDate.getUTCDay());
    const start = startDate.getTime();
    const offset = startDate.getUTCDay();

    function draw() {
      close();
      const counts = new Map<string, number[]>();
      const posts = new Map<string, Activity[]>();
      for (const event of events) {
        const timestamp = Date.parse(event.date);
        const source = sources.indexOf(event.source);
        if (!Number.isFinite(timestamp) || source < 0) continue;
        const date = new Date(timestamp).toISOString().slice(0, 10);
        const values = counts.get(date) ?? [0, 0, 0, 0];
        values[source]++;
        counts.set(date, values);
        posts.set(date, [...(posts.get(date) ?? []), event]);
      }
      const width = Math.ceil(((end - start) / DAY + 1 + offset) / 7) * 14;
      const calendar = document.createElement('div');
      calendar.className = 'activity-calendar';
      calendar.style.width = `${width + 8}px`;
      calendar.setAttribute('aria-label', `${new Date(start).toISOString().slice(0, 10)}〜${today}のGitHub活動と投稿・更新履歴`);
      // Allocate more space near the focus while keeping both ends fixed.
      // Normalizing the track widths compresses distant cells instead of overflowing.
      const lens = (focusColumn: number, focusRow: number) => {
        const bounds = root.getBoundingClientRect();
        const calendarBounds = calendar.getBoundingClientRect();
        const viewport = grid.getBoundingClientRect();
        const firstColumn = Math.max(0, Math.min(focusColumn, Math.floor(grid.scrollLeft / 14)));
        const lastColumn = Math.min(Math.ceil(width / 14) - 1, Math.max(focusColumn, Math.floor((grid.scrollLeft + grid.clientWidth - 5) / 14)));
        const tracks = (count: number, focus: number, extent: number) => {
          const weights = Array.from({ length: count }, (_, i) => 1 + 1.2 * Math.exp(-Math.abs(i - focus) * 1.1));
          const total = weights.reduce((a, b) => a + b, 0);
          let edge = 0;
          return weights.map(weight => {
            const size = weight / total * extent;
            const track = { center: edge + size / 2, size };
            edge += size;
            return track;
          });
        };
        const left = Math.max(calendarBounds.left + 4, viewport.left + 4);
        const extent = Math.min(width - 8 - firstColumn * 14, grid.clientWidth - 8);
        const columns = tracks(lastColumn - firstColumn + 1, focusColumn - firstColumn, extent);
        const rows = tracks(7, focusRow, 98);
        let selected = { left: 0, top: 0, size: 11 };
        calendar.querySelectorAll<HTMLButtonElement>('.activity-cell').forEach(button => {
          const column = Number(button.style.gridColumn) - 1;
          const row = Number(button.style.gridRow) - 1;
          if (column < firstColumn || column > lastColumn) {
            button.style.visibility = 'hidden';
            return;
          }
          const x = columns[column - firstColumn];
          const y = rows[row];
          const size = Math.max(1, Math.min(x.size, y.size) - 2);
          const centerX = left + x.center;
          const centerY = calendarBounds.top + 4 + y.center;
          const originalX = calendarBounds.left + 4 + column * 14 + 5.5;
          const originalY = calendarBounds.top + 4 + row * 14 + 5.5;
          button.style.visibility = '';
          button.style.transform = `translate(${centerX - originalX}px, ${centerY - originalY}px) scale(${size / 11})`;
          if (column === focusColumn && row === focusRow) selected = { left: centerX - size / 2 - bounds.left, top: centerY - size / 2 - bounds.top, size };
        });
        return selected;
      };
      resetLens = () => {
        calendar.querySelectorAll<HTMLButtonElement>('.activity-cell').forEach(button => {
          button.style.transform = '';
          button.style.visibility = '';
        });
      };
      for (let timestamp = start, index = offset; timestamp <= end; timestamp += DAY, index++) {
        const date = new Date(timestamp).toISOString().slice(0, 10);
        const values = counts.get(date) ?? [0, 0, 0, 0];
        const cell = document.createElement('button');
        cell.type = 'button';
        cell.className = 'activity-cell';
        cell.dataset.date = date;
        cell.style.gridColumn = String(Math.floor(index / 7) + 1);
        cell.style.gridRow = String(index % 7 + 1);
        const contribution = github.get(date);
        const label = `${date}: GitHub ${contribution ? `${contribution.count}件` : '未取得'} / ${sources.map((name, i) => `${name} ${values[i]}件`).join(' / ')}`;
        cell.setAttribute('aria-label', label);
        cell.setAttribute('aria-expanded', 'false');
        cell.style.background = `var(--grass-${contribution?.level ?? 0})`;
        values.forEach((count, i) => {
          if (!count) return;
          const dot = document.createElement('span');
          dot.className = 'activity-dot';
          dot.style.background = colors[i];
          dot.style.left = `${i % 2 ? 6 : 1}px`;
          dot.style.top = `${i < 2 ? 1 : 6}px`;
          cell.append(dot);
        });
        const open = () => {
          cancelClose();
          if (activeCell === cell && !zoom.hidden) return;
          activeCell?.setAttribute('aria-expanded', 'false');
          activeCell = cell;
          cell.setAttribute('aria-expanded', 'true');
          detail.hidden = true;
          zoom.replaceChildren();
          zoom.style.background = `var(--grass-${contribution?.level ?? 0})`;
          zoom.setAttribute('aria-label', label);
          sources.forEach((source, i) => {
            const quadrant = document.createElement('div');
            quadrant.className = 'zoom-quadrant';
            for (const post of (posts.get(date) ?? []).filter(post => post.source === source && /^https:\/\//.test(post.url))) {
              const link = document.createElement('a');
              link.className = 'zoom-post';
              link.href = post.url;
              link.target = '_blank';
              link.rel = 'noopener noreferrer';
              link.style.background = colors[i];
              link.setAttribute('aria-label', `${source} · ${post.title || '投稿を見る'}`);
              const showLink = () => {
                cancelClose();
                const heading = document.createElement('strong');
                heading.textContent = `${date} · ${source}`;
                const article = document.createElement('a');
                article.href = post.url;
                article.target = '_blank';
                article.rel = 'noopener noreferrer';
                article.textContent = `${post.title || '投稿を見る'} ↗`;
                detail.replaceChildren(heading, article);
                detail.hidden = false;
                const bounds = root.getBoundingClientRect();
                const rect = zoom.getBoundingClientRect();
                detail.style.left = `${Math.max(0, Math.min(rect.left - bounds.left, bounds.width - detail.offsetWidth))}px`;
                detail.style.top = `${rect.bottom - bounds.top + 6}px`;
              };
              link.addEventListener('pointerenter', showLink);
              link.addEventListener('focus', showLink);
              quadrant.append(link);
            }
            zoom.append(quadrant);
          });
          zoom.hidden = false;
          const selected = lens(Math.floor(index / 7), index % 7);
          zoom.style.left = `${selected.left}px`;
          zoom.style.top = `${selected.top}px`;
          zoom.style.width = `${selected.size}px`;
          zoom.style.height = `${selected.size}px`;
        };
        cell.addEventListener('pointerenter', (event) => { if (event.pointerType !== 'touch') open(); });
        cell.addEventListener('focus', () => {
          if (suppressFocus) return;
          cell.scrollIntoView({ block: 'nearest', inline: 'nearest' });
          setTimeout(() => {
            if (document.activeElement === cell) open();
          }, 80);
        });
        cell.addEventListener('click', open);
        cell.addEventListener('keydown', (event) => {
          if (event.key === 'Tab' && !event.shiftKey && zoom.querySelector('a')) {
            event.preventDefault();
            zoom.querySelector<HTMLAnchorElement>('a')?.focus();
          }
          const step = { ArrowUp: -1, ArrowDown: 1, ArrowLeft: -7, ArrowRight: 7 }[event.key];
          if (step !== undefined) {
            event.preventDefault();
            const cells = [...calendar.querySelectorAll<HTMLButtonElement>('button')];
            cells[cells.indexOf(cell) + step]?.focus();
          }
        });
        calendar.append(cell);
      }
      grid.replaceChildren(calendar);
    }

    draw();
    const githubTask = (async () => {
      try {
        const response = await fetch('https://github-contributions-api.jogruber.de/v4/nattsu628878?y=last', { signal: AbortSignal.timeout(15000) });
        if (!response.ok) throw new Error(String(response.status));
        const data = await response.json();
        for (const day of data.contributions) github.set(day.date, { count: day.count, level: Math.max(0, Math.min(4, day.level)) });
        githubStatus.textContent = '';
      } catch {
        githubStatus.textContent = 'GitHubの取得に失敗しました。投稿・更新の点のみ表示しています。';
      }
      draw();
    })();
    try {
      let cursor: string | undefined;
      const seen = new Set<string>();
      do {
        const params = new URLSearchParams({ actor: 'nattsu628878.bsky.social', limit: '100', filter: 'posts_no_replies' });
        if (cursor) params.set('cursor', cursor);
        const response = await fetch(`https://public.api.bsky.app/xrpc/app.bsky.feed.getAuthorFeed?${params}`, { signal: AbortSignal.timeout(15000) });
        if (!response.ok) throw new Error(String(response.status));
        const data = await response.json();
        for (const item of data.feed) {
          if (!item.reason && !seen.has(item.post.uri)) {
            seen.add(item.post.uri);
            events.push({ date: item.post.record.createdAt, source: 'Bluesky', title: item.post.record.text || 'Bluesky投稿', url: `https://bsky.app/profile/nattsu628878.bsky.social/post/${item.post.uri.split('/').pop()}` });
          }
        }
        const oldest = data.feed.at(-1);
        const oldestDate = oldest?.reason?.indexedAt ?? oldest?.post?.record?.createdAt;
        const next = data.cursor;
        if (!next || next === cursor || !oldestDate || Date.parse(oldestDate) < start) break;
        cursor = next;
      } while (cursor);
      status.textContent = 'マスを拡大し、色付きの四角にホバーで投稿名を表示、クリックで開きます。';
    } catch {
      status.textContent = 'Blueskyの取得に失敗しました。取得済みの投稿のみ表示しています。';
    }
    draw();
    await githubTask;
  }

  document.querySelectorAll<HTMLElement>('.publishing-activity').forEach(renderActivity);
</script>

<style>
  .legend { display: flex; flex-wrap: wrap; gap: 0.5rem 1rem; list-style: none; padding: 0; margin: 0.65rem 0; font-size: 0.8rem; }
  .legend li { display: flex; align-items: center; gap: 0.4rem; }
  .legend span { width: 0.5rem; height: 0.5rem; border-radius: 50%; }
  .legend .github-key { background: var(--grass-3); border-radius: 2px; }
  .activity-status, .github-status { font-size: 0.75rem; color: var(--text-muted); margin: 0.4rem 0; }
  .github-status:empty { display: none; }
  .publishing-activity { position: relative; }
  .contributions { padding: 12px 0; }
  .publishing-activity :global(.activity-calendar) { display: grid; grid-template-rows: repeat(7, 11px); grid-auto-columns: 11px; gap: 3px; padding: 4px; }
  .publishing-activity :global(.activity-cell) { position: relative; width: 11px; height: 11px; border: 1px solid var(--border-light); border-radius: 2px; padding: 0; cursor: pointer; transition: transform 180ms ease, box-shadow 180ms ease; }
  .publishing-activity :global(.activity-cell:focus-visible), .publishing-activity :global(.activity-cell[aria-expanded="true"]) { z-index: 2; outline: 1px solid var(--accent); }
  .publishing-activity :global(.activity-dot) { position: absolute; width: 3px; height: 3px; border-radius: 50%; box-shadow: 0 0 0 0.4px var(--bg-panel); pointer-events: none; }
  .day-zoom { position: absolute; z-index: 9; width: 90px; height: 90px; padding: 3px; display: grid; grid-template-columns: repeat(2, minmax(0, 1fr)); grid-template-rows: repeat(2, minmax(0, 1fr)); gap: 3px; border: 1px solid var(--accent); border-radius: 3px; }
  .day-zoom[hidden] { display: none; }
  .day-zoom:not([hidden]) { animation: zoom-in 200ms ease-out; }
  .day-zoom :global(.zoom-quadrant) { display: grid; grid-template-columns: repeat(auto-fit, minmax(5px, 1fr)); gap: 2px; min-height: 0; }
  .day-zoom :global(.zoom-post) { display: block; min-height: 0; border-radius: 2px; box-shadow: 0 0 0 1px #ffffff80; transition: transform 140ms ease; }
  .day-zoom :global(.zoom-post:hover), .day-zoom :global(.zoom-post:focus-visible) { transform: scale(1.12); outline: 2px solid var(--text-primary); outline-offset: 2px; z-index: 1; }
  @keyframes zoom-in { from { opacity: 0; transform: scale(0.85); } to { opacity: 1; transform: scale(1); } }
  .day-detail { position: absolute; z-index: 10; width: min(320px, 100%); max-height: 280px; overflow: auto; padding: 0.8rem; border: 1px solid var(--border-light); border-radius: 8px; background: var(--bg-panel); box-shadow: 0 8px 28px #0002; font-size: 0.8rem; }
  .day-detail:not([hidden]) { animation: appear 160ms ease-out; }
  .day-detail :global(ul) { list-style: none; padding: 0; margin: 0.5rem 0 0; }
  .day-detail :global(a) { display: flex; gap: 0.5rem; align-items: baseline; padding: 0.5rem; color: var(--text-primary); text-decoration: none; border-radius: 4px; overflow-wrap: anywhere; }
  .day-detail :global(a:hover), .day-detail :global(a:focus-visible) { background: var(--accent-bg); outline: 1px solid var(--accent); }
  .day-detail :global(.post-marker) { flex: 0 0 8px; height: 8px; border-radius: 2px; }
  @keyframes appear { from { opacity: 0; transform: translateY(-3px) scale(0.98); } to { opacity: 1; transform: none; } }
  @media (prefers-reduced-motion: reduce) { .publishing-activity :global(.activity-cell), .day-zoom :global(.zoom-post) { transition: none; } .day-detail:not([hidden]), .day-zoom:not([hidden]) { animation: none; } }
</style>
